# Copy this file to .env and adjust as needed.
NODE_ENV=development
PORT=3000

# Postgres connection.
# Local (docker-compose default):
DATABASE_URL=postgres://payflow:payflow@localhost:5432/payflow
# Supabase (Project Settings -> Database -> Connection string -> URI):
# DATABASE_URL=postgres://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres

# Set true for managed Postgres like Supabase (auto-on if the URL contains "supabase").
# PGSSL=true

# Apply db/schema.sql on startup (useful on hosts without a separate migrate step).
# AUTO_MIGRATE=true

# When set, admin/sim/fault/incident endpoints require header  x-admin-key: <key>
# ADMIN_API_KEY=

# CORS allow-origin for the API (merchant app / APK). "*" for the lab.
# CORS_ORIGIN=*

# Public base URL the fake PSP posts webhooks to (auto on Render via RENDER_EXTERNAL_URL).
# BASE_URL=http://localhost:3000

# Where the fake PSP delivers webhooks back to (defaults to http://localhost:PORT)
# BASE_URL=http://localhost:3000

# Webhook secrets (the fake PSP signs with these; the receiver verifies with them)
STRIPE_WEBHOOK_SECRET=whsec_stripe_dev
PAYSTACK_WEBHOOK_SECRET=sk_paystack_dev
FLUTTERWAVE_WEBHOOK_HASH=flw_verif_dev

# --- Phase 4: REAL Paystack sandbox ---
# Get this from your Paystack dashboard -> Settings -> API Keys (TEST secret key).
# Leave empty to keep live checkout disabled.
PAYSTACK_SECRET_KEY=
# PAYSTACK_API_URL=https://api.paystack.co
